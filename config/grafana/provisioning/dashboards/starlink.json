        "onclick": "\n\n",
        "script": "function loadMap() {\n  var xhr = new XMLHttpRequest();\n  xhr.open(\"GET\", \"/public/obstruction/map.json?t=\" + Date.now(), false);\n  xhr.send(null);\n  if (xhr.status < 200 || xhr.status >= 300) {\n    throw new Error(\"HTTP \" + xhr.status);\n  }\n  return JSON.parse(xhr.responseText);\n}\nvar map;\ntry {\n  map = loadMap();\n} catch (e) {\n  return {\n    data: [],\n    layout: {\n      paper_bgcolor: \"rgba(0,0,0,0)\",\n      plot_bgcolor: \"rgba(0,0,0,0)\",\n      font: {color: \"darkgrey\", size: 12},\n      title: {text: \"Obstruction map unavailable: \" + e, font: {size: 12, color: \"#F2495C\"}},\n      margin: {t: 40, b: 20, l: 20, r: 20}\n    }\n  };\n}\nreturn {\n  data: [{\n    z: map.snr,\n    type: \"heatmap\",\n    colorscale: [[0, \"rgb(255,0,0)\"], [1, \"rgb(255,255,255)\"]],\n    zmin: 0,\n    zmax: 1,\n    zsmooth: false,\n    hovertemplate: \"SNR %{z:.2f}<extra></extra>\",\n    showscale: false,\n    xgap: 0,\n    ygap: 0\n  }],\n  layout: {\n    paper_bgcolor: \"rgba(0,0,0,0)\",\n    plot_bgcolor: \"#000000\",\n    font: {color: \"darkgrey\", size: 11},\n    margin: {t: 28, b: 32, l: 32, r: 12},\n    xaxis: {showticklabels: false, showgrid: false, zeroline: false, ticks: \"\", constrain: \"domain\"},\n    yaxis: {autorange: \"reversed\", showticklabels: false, showgrid: false, zeroline: false, ticks: \"\", scaleanchor: \"x\", scaleratio: 1, constrain: \"domain\"},\n    annotations: [\n      {text: \"N\", x: 0.5, y: 1.04, xref: \"paper\", yref: \"paper\", showarrow: false, font: {size: 12, color: \"darkgrey\"}},\n      {text: \"S\", x: 0.5, y: -0.08, xref: \"paper\", yref: \"paper\", showarrow: false, font: {size: 12, color: \"darkgrey\"}},\n      {text: \"W\", x: -0.08, y: 0.5, xref: \"paper\", yref: \"paper\", showarrow: false, font: {size: 12, color: \"darkgrey\"}},\n      {text: \"E\", x: 1.04, y: 0.5, xref: \"paper\", yref: \"paper\", showarrow: false, font: {size: 12, color: \"darkgrey\"}}\n    ],\n    title: {\n      text: map.rows + \"\u00d7\" + map.cols + \" \u00b7 \" + (map.map_reference_frame_name || \"\") + \" \u00b7 red=obstructed \u00b7 white=clear\",\n      font: {size: 11, color: \"darkgrey\"}\n    }\n  }\n};"
